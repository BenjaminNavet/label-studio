# Copy to .env (never committed, chmod 600) and replace every value.
# Public (or internal) host name of the server, without scheme.
LABEL_STUDIO_DOMAIN=ls.example.org
# TLS mode: internal | admin@example.org (Let's Encrypt) | /certs/fullchain.pem /certs/privkey.pem
CADDY_TLS=internal
# Image to run (built locally or loaded with docker load).
LABEL_STUDIO_IMAGE=label-studio-rbac:local
# Postgres password (long and random).
POSTGRES_PASSWORD=CHANGEME
# Bootstrap administrator (organization owner), created at first start.
LABEL_STUDIO_USERNAME=admin@example.org
LABEL_STUDIO_PASSWORD=CHANGEME
# Backups (used by backup.sh): target directory and retention in days.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
